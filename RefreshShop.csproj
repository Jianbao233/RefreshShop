<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>RefreshShop</RootNamespace>
    <AssemblyName>RefreshShop</AssemblyName>
    <!-- The manifest is the version source for DLL, staging and local archives. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/mod_manifest.json')), '(?&lt;=&quot;version&quot;: &quot;)[^&quot;]+').Value)</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="RefreshShop.Tests" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RitsuLib.ModSettingsInterop.ProviderType" Value="RefreshShop.RitsuLibSettingsProvider" />
    <AssemblyMetadata Include="RitsuLib.ModSettingsMirror.Mod.RefreshShop.DisableSources" Value="ModConfig" />
  </ItemGroup>
</Project>
